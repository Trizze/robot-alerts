# npm run setup creates a private .env; never share that file.
# Node loads .env into the environment at startup; app code uses process.env.
PORT=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_BROADCASTER_IDS=
TWITCH_BROADCASTER_LOGIN=
TWITCH_BOT_USER_ID=
TWITCH_BOT_LOGIN=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
OPENAI_API_KEY=

# Comma-separated Twitch user IDs; empty disables live reactions. Use * only to permit everyone.
ALLOWED_VIEWER_IDS=
